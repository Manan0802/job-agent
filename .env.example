# Free-first LLM: direct Gemini API (Google AI Studio, OpenAI-compatible endpoint)
# Get a free key at https://aistudio.google.com/apikey
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Gemini's free tier is 20 requests a day *per model*, so the volume work and
# the occasional hard job use different models and different daily budgets.
LLM_MODEL=gemini-3.5-flash-lite
LLM_MODEL_HEAVY=gemini-3.5-flash
# Fallback provider: direct Groq API (used automatically if Gemini errors/rate-limits)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
# Job alerts (optional — alerts are skipped when these are blank)
# Create a bot with @BotFather on Telegram, then message it once and read your
# chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Referral search (optional — without these, referrals come from your LinkedIn
# CSV export plus a manual search link, at zero cost)
# Serper gives 2,500 free searches once, no card: https://serper.dev
SERPER_API_KEY=
# SerpApi resets 250 free searches every month, no card: https://serpapi.com
SERPAPI_API_KEY=
# Your own LinkedIn connections export (LinkedIn → Settings & Privacy →
# Data Privacy → Get a copy of your data → Connections)
LINKEDIN_CONNECTIONS_CSV=./data/connections/Connections.csv
# Hunting on a schedule (optional — off until HUNT_SEARCH_TERM is set, so the
# server never spends your free tier unasked). It alerts only about matches you
# have not been told about before, so set TELEGRAM_* above too.
HUNT_SEARCH_TERM=
HUNT_EVERY_HOURS=0
HUNT_LOCATION=India
HUNT_TOP_N=10
ALERT_MIN_SCORE=70
# Local matching model (downloaded once, runs offline)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Set this before exposing the app beyond localhost (see docs/DEPLOY.md).
# Blank means no password, which is right while it only listens on 127.0.0.1.
APP_PASSWORD=
# Paths
DB_PATH=./data/db/career_agent.db
PROFILE_PATH=./data/profile/profile.json
