# Free-first LLM: direct Gemini API (Google AI Studio, OpenAI-compatible endpoint)
# Get a free key at https://aistudio.google.com/apikey
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash
# Fallback provider: direct Groq API (used automatically if Gemini errors/rate-limits)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
# Job alerts (optional — alerts are skipped when these are blank)
# Create a bot with @BotFather on Telegram, then message it once and read your
# chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Referral search (optional — without these, referrals come from your LinkedIn
# CSV export plus a manual search link, at zero cost)
# Serper gives 2,500 free searches once, no card: https://serper.dev
SERPER_API_KEY=
# SerpApi resets 250 free searches every month, no card: https://serpapi.com
SERPAPI_API_KEY=
# Your own LinkedIn connections export (LinkedIn → Settings & Privacy →
# Data Privacy → Get a copy of your data → Connections)
LINKEDIN_CONNECTIONS_CSV=./data/connections/Connections.csv
# Local matching model (downloaded once, runs offline)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Paths
DB_PATH=./data/db/career_agent.db
PROFILE_PATH=./data/profile/profile.json
